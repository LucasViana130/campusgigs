# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente local.
# O ".env" real NAO deve ser commitado (ja esta no .gitignore).

DB_NAME=campusgigs
DB_USER=campusgigs
DB_PASSWORD=campusgigs
DB_PORT=5432

APP_PORT=8080

# Chave usada para assinar os tokens JWT (HS256 exige pelo menos 256 bits / 32 caracteres).
# Gere a sua, por exemplo: openssl rand -base64 32
JWT_SECRET=troque-esta-chave-por-uma-secreta-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=3600000

CEP_API_BASE_URL=https://viacep.com.br
